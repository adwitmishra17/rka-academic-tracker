rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isActiveAdmin(path) {
      return firestore.exists(path) && firestore.get(path).data.get('isActive', true) != false;
    }

    // Syllabus PDFs — one per class + subject, shown to parents class-wise.
    // These are standard CBSE syllabus documents (not sensitive), so reads are
    // public: the parent app links straight to the ?alt=media URL. Writes are
    // restricted to Tracker admins from the browser; teachers upload through
    // the Teacher-PWA server (Firebase Admin SDK), which is rules-exempt.
    match /syllabus/{allPaths=**} {
      allow read: if true;
      // Only ACTIVE admins (isActive:false revokes, same as firestore.rules).
      allow write: if request.auth != null && (
        request.auth.token.get('email', '') == 'adwit@rkacademyballia.in' ||
        isActiveAdmin(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        isActiveAdmin(/databases/(default)/documents/admins/$(request.auth.token.get('email', '').lower()))
      );
    }

    // Everything else stays locked (no other Storage feature exists yet).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
